<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
    <declaration>
        // Crane Digital Twin (DT) — IEC 60204-1:2016, EN 13001-1:2015, ISO 4301-1:1986
        // Structural integrity / load-cycle monitoring engineer perspective.
        // Tracks cumulative hoist cycles vs ISO 4301 M4 duty limit and monitors
        // load magnitude vs EN 13001 rated capacity.
        // Labels differ from PT; semantically equivalent under crane domain ontology.
        // DT observes with up to 3 time-unit telemetry latency (relaxed upper bounds).
        clock t_cycle, t_motion, t_rest, t_inspect;
        chan hoist_command,
             cycle_logged,
             bridge_motion_start, bridge_motion_end,
             load_setdown_event,
             load_exceedance_event,
             protective_stop_command,
             duty_cycle_rest_start, duty_cycle_rest_end,
             inspection_start, inspection_complete;
    </declaration>

    <template>
        <name>CraneDT</name>

        <location id="dt_idle" x="0" y="0">
            <name x="-10" y="-34">DT_IDLE</name>
        </location>

        <location id="dt_cycle_active" x="300" y="0">
            <name x="260" y="-34">DT_CYCLE_ACTIVE</name>
            <label kind="invariant" x="260" y="17">t_cycle &lt;= 123</label>
        </location>

        <location id="dt_floor_dwell" x="600" y="0">
            <name x="560" y="-34">DT_FLOOR_DWELL</name>
        </location>

        <location id="dt_bridge_motion" x="900" y="0">
            <name x="860" y="-34">DT_BRIDGE_MOTION</name>
            <label kind="invariant" x="860" y="17">t_motion &lt;= 63</label>
        </location>

        <location id="dt_load_exceedance" x="600" y="300">
            <name x="560" y="266">DT_LOAD_EXCEEDANCE</name>
            <label kind="invariant" x="560" y="317">t_cycle &lt;= 5</label>
        </location>

        <location id="dt_protective_stop" x="900" y="300">
            <name x="860" y="266">DT_PROTECTIVE_STOP</name>
        </location>

        <location id="dt_duty_rest" x="0" y="300">
            <name x="-10" y="266">DT_DUTY_REST</name>
            <label kind="invariant" x="-10" y="317">t_rest &lt;= 63</label>
        </location>

        <location id="dt_inspection" x="0" y="-150">
            <name x="-10" y="-184">DT_INSPECTION</name>
            <label kind="invariant" x="-10" y="-133">t_inspect &lt;= 123</label>
        </location>

        <init ref="dt_idle"/>

        <!-- DT_IDLE -> DT_CYCLE_ACTIVE : hoist_command! -->
        <!-- Semantically equivalent to hoist_up! and hoist_down! in PT:
             both require current_load <= rated_load and hoist within bounds -->
        <transition>
            <source ref="dt_idle"/>
            <target ref="dt_cycle_active"/>
            <label kind="synchronisation" x="100" y="-17">hoist_command!</label>
            <label kind="assignment" x="100" y="0">t_cycle := 0</label>
        </transition>

        <!-- DT_CYCLE_ACTIVE -> DT_FLOOR_DWELL : cycle_logged! [guard: t_cycle >= 5 && t_cycle <= 123] -->
        <!-- Semantically equivalent to hoist_complete! in PT; +3 units telemetry latency -->
        <transition>
            <source ref="dt_cycle_active"/>
            <target ref="dt_floor_dwell"/>
            <label kind="guard" x="370" y="-17">t_cycle &gt;= 5 &amp;&amp; t_cycle &lt;= 123</label>
            <label kind="synchronisation" x="370" y="0">cycle_logged!</label>
            <label kind="assignment" x="370" y="17">t_cycle := 0</label>
        </transition>

        <!-- DT_FLOOR_DWELL -> DT_BRIDGE_MOTION : bridge_motion_start! -->
        <transition>
            <source ref="dt_floor_dwell"/>
            <target ref="dt_bridge_motion"/>
            <label kind="synchronisation" x="710" y="-17">bridge_motion_start!</label>
            <label kind="assignment" x="710" y="0">t_motion := 0</label>
        </transition>

        <!-- DT_BRIDGE_MOTION -> DT_IDLE : bridge_motion_end! [guard: t_motion >= 3 && t_motion <= 63] -->
        <!-- +3 units telemetry tolerance on upper bound -->
        <transition>
            <source ref="dt_bridge_motion"/>
            <target ref="dt_idle"/>
            <label kind="guard" x="470" y="50">t_motion &gt;= 3 &amp;&amp; t_motion &lt;= 63</label>
            <label kind="synchronisation" x="470" y="67">bridge_motion_end!</label>
            <label kind="assignment" x="470" y="84">t_motion := 0</label>
        </transition>

        <!-- DT_FLOOR_DWELL -> DT_IDLE : load_setdown_event! -->
        <transition>
            <source ref="dt_floor_dwell"/>
            <target ref="dt_idle"/>
            <label kind="synchronisation" x="250" y="-50">load_setdown_event!</label>
        </transition>

        <!-- DT_CYCLE_ACTIVE -> DT_LOAD_EXCEEDANCE : load_exceedance_event! [t_cycle reset] -->
        <transition>
            <source ref="dt_cycle_active"/>
            <target ref="dt_load_exceedance"/>
            <label kind="synchronisation" x="350" y="150">load_exceedance_event!</label>
            <label kind="assignment" x="350" y="167">t_cycle := 0</label>
        </transition>

        <!-- DT_FLOOR_DWELL -> DT_LOAD_EXCEEDANCE : load_exceedance_event! [t_cycle reset] -->
        <transition>
            <source ref="dt_floor_dwell"/>
            <target ref="dt_load_exceedance"/>
            <label kind="synchronisation" x="570" y="150">load_exceedance_event!</label>
            <label kind="assignment" x="570" y="167">t_cycle := 0</label>
        </transition>

        <!-- DT_LOAD_EXCEEDANCE -> DT_PROTECTIVE_STOP : protective_stop_command! [guard: t_cycle <= 1] -->
        <transition>
            <source ref="dt_load_exceedance"/>
            <target ref="dt_protective_stop"/>
            <label kind="guard" x="710" y="317">t_cycle &lt;= 1</label>
            <label kind="synchronisation" x="710" y="334">protective_stop_command!</label>
        </transition>

        <!-- DT_PROTECTIVE_STOP -> DT_IDLE : tau (self-recovery, matches PT's tau reset_crane!) -->
        <transition>
            <source ref="dt_protective_stop"/>
            <target ref="dt_idle"/>
        </transition>

        <!-- DT_IDLE -> DT_DUTY_REST : duty_cycle_rest_start! -->
        <transition>
            <source ref="dt_idle"/>
            <target ref="dt_duty_rest"/>
            <label kind="synchronisation" x="-180" y="150">duty_cycle_rest_start!</label>
            <label kind="assignment" x="-180" y="167">t_rest := 0</label>
        </transition>

        <!-- DT_DUTY_REST -> DT_IDLE : duty_cycle_rest_end! [guard: t_rest >= 30 && t_rest <= 63] -->
        <transition>
            <source ref="dt_duty_rest"/>
            <target ref="dt_idle"/>
            <label kind="guard" x="-180" y="50">t_rest &gt;= 30 &amp;&amp; t_rest &lt;= 63</label>
            <label kind="synchronisation" x="-180" y="67">duty_cycle_rest_end!</label>
        </transition>

        <!-- DT_IDLE -> DT_INSPECTION : inspection_start! -->
        <transition>
            <source ref="dt_idle"/>
            <target ref="dt_inspection"/>
            <label kind="synchronisation" x="-180" y="-100">inspection_start!</label>
            <label kind="assignment" x="-180" y="-83">t_inspect := 0</label>
        </transition>

        <!-- DT_INSPECTION -> DT_IDLE : inspection_complete! [guard: t_inspect >= 20 && t_inspect <= 123] -->
        <transition>
            <source ref="dt_inspection"/>
            <target ref="dt_idle"/>
            <label kind="guard" x="-180" y="-50">t_inspect &gt;= 20 &amp;&amp; t_inspect &lt;= 123</label>
            <label kind="synchronisation" x="-180" y="-33">inspection_complete!</label>
        </transition>

    </template>

    <system>CraneDT = CraneDT(); system CraneDT;</system>

</nta>
