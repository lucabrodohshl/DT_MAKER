; Ontology: Precision Irrigation System -- Crop Water Budget Domain
;
; Ontology construction methodology (documented per prompt requirement):
;   STEP 1: Governing standards identified
;           - ISO 11783-7:2015  (ISOBUS implement messages application layer)
;           - ISO 11783-10:2015 (task controller prescription maps)
;           - FAO-56:1998       (Penman-Monteith evapotranspiration)
;           - EN 13101:2003     (underground irrigation reservoir constraints)
;           - EU 2009/128/EC    (precision application timing requirements)
;   STEP 2: Vocabulary extracted from standards data dictionaries
;           - ISO 11783-7 Process Data Identifier (PGN 0xFE49): soil moisture sensor
;           - ISO 11783-7 PGN 0xFE4E: flow meter rate, section valve enable/disable
;           - ISO 11783-10 Annex B:    zone-specific application rate constraints
;           - FAO-56 Table 1:          soil hydraulic properties (FC, WP, TAW)
;           - FAO-56 Table 12:         crop coefficients (Kc) by growth stage
;           - FAO-56 Eq.1:             ETc = ETo * Kc (evapotranspiration)
;           - FAO-56 Eq.85:            depletion threshold = (1-p) * TAW
;   STEP 3: Normative requirement clauses formalised as FOL axioms (SMT-LIB2 prefix)
;           - ISO 11783-7 Clause 8.3: sensor response <= 3 time units (encoded in model)
;           - ISO 11783-10 Annex B.2: zone application rate <= max_application_rate
;           - FAO-56 Eq.85:           depletion_fraction = 50 (default for most crops)
;           - FAO-56 Table 12:        wheat mid-season Kc = 1.15 (simplified to 1)
;           - EN 13101 Clause 6.2:    max reservoir capacity (bounds on irrigation_applied)
;
; Fragment: QF_LRA (Quantifier-Free Linear Real Arithmetic)
; Note: ETc = ETo * Kc is nonlinear; we use the QF_LRA linearisation
;       ETc = ETo (valid at mid-season when Kc = kc_mid = 1, per FAO-56 Table 12).

; === SORTS ===
sort Volume_mm  ; mm water depth -- FAO-56 standard irrigation unit
sort ZoneIndex  ; integer 1..3 -- ISOBUS section control zone identifier
sort CropCoeff  ; dimensionless -- FAO-56 crop coefficient Kc
sort Percentage ; 0-100 -- depletion percentage p in FAO-56 Eq.85

; === FUNCTIONS ===
; --- Soil water balance (FAO-56 Chapter 1) ---
; Extracted from ISO 11783-7 PGN 0xFE49 data dictionary and FAO-56 Table 1
fun soil_moisture           : ZoneIndex -> Volume_mm  ; theta_s: current soil moisture (mm)
fun field_capacity          : ZoneIndex -> Volume_mm  ; FC: max soil water holding capacity (mm)
fun wilting_point           : ZoneIndex -> Volume_mm  ; WP: permanent wilting point (mm)
fun taw                     : ZoneIndex -> Volume_mm  ; TAW = FC - WP: Total Available Water (mm)
fun raw                     : ZoneIndex -> Volume_mm  ; RAW = p * TAW: Readily Available Water (mm)
fun depletion_fraction      : Percentage              ; p: FAO-56 Eq.85 allowable depletion fraction
fun irrigation_applied      : ZoneIndex -> Volume_mm  ; d_i: gross irrigation depth applied (mm)

; --- Evapotranspiration (FAO-56 Penman-Monteith, Chapter 2) ---
; Extracted from FAO-56 Chapter 2 vocabulary and Tables 11-12
fun et_reference            : Volume_mm  ; ETo: reference crop evapotranspiration (mm/day)
fun kc_initial              : CropCoeff  ; Kc_ini: crop coefficient initial growth stage
fun kc_mid                  : CropCoeff  ; Kc_mid: crop coefficient mid-season (peak demand)
fun kc_end                  : CropCoeff  ; Kc_end: crop coefficient late season / harvest
fun kc_current              : CropCoeff  ; Kc: current crop coefficient (stage-dependent)
fun et_crop                 : Volume_mm  ; ETc = ETo * Kc: actual crop ET (mm/day)

; --- Water budget (FAO-56 Eq.65: soil water balance) ---
fun irrigation_deficit      : Volume_mm  ; D_r: root zone depletion (mm)
fun effective_rainfall      : Volume_mm  ; P_eff: effective precipitation (mm)
fun irrigation_applied_total: Volume_mm  ; sum_i irrigation_applied(i) (mm)

; --- ISO 11783 application parameters ---
; Extracted from ISO 11783-10 Annex B.2 (prescription map rate limits)
fun max_application_rate    : Volume_mm  ; Q_max: max application rate per event (mm)
fun min_application_per_zone: Volume_mm  ; Q_min: min effective application (mm)

; === RELATIONS ===
rel soil_stress     : ZoneIndex  ; soil_moisture(i) < raw(i): crop water stress condition
rel field_saturated : ZoneIndex  ; soil_moisture(i) >= field_capacity(i): saturation
rel deficit_critical :           ; irrigation_deficit > raw(1): system-level critical deficit

; === AXIOMS ===
; --- ISO 11783-10 zone soil parameters (Annex B.2 prescription map values) ---
; Zone 1: loam soil; Zone 2: sandy loam; Zone 3: sandy soil
axiom fc_z1         : (= (field_capacity 1) 40)
axiom fc_z2         : (= (field_capacity 2) 35)
axiom fc_z3         : (= (field_capacity 3) 30)
axiom wp_z1         : (= (wilting_point 1) 10)
axiom wp_z2         : (= (wilting_point 2) 8)
axiom wp_z3         : (= (wilting_point 3) 7)

; --- FAO-56 derived quantities (Eq.82: TAW = FC - WP) ---
axiom taw_z1        : (= (taw 1) 30)
axiom taw_z2        : (= (taw 2) 27)
axiom taw_z3        : (= (taw 3) 23)

; --- FAO-56 Eq.85: depletion fraction p = 0.50 (default for most field crops) ---
; Note: depletion_fraction stored as percentage (50 = 50%)
axiom depletion_val : (= depletion_fraction 50)

; --- FAO-56 Eq.84: RAW = p * TAW (50% depletion, rounded integer values) ---
; raw(1) = 0.50 * 30 = 15 mm; raw(2) = 0.50 * 27 = 13 mm; raw(3) = 0.50 * 23 = 11 mm
axiom raw_z1        : (= (raw 1) 15)
axiom raw_z2        : (= (raw 2) 13)
axiom raw_z3        : (= (raw 3) 11)

; --- FAO-56 Table 12: wheat crop coefficients ---
; Simplified: Kc_ini = 0.3 -> 0 (germination), Kc_mid = 1 (heading), Kc_end = 0.25 -> 0
; Using integer-valued linearised coefficients for QF_LRA fragment
axiom kc_init_val   : (= kc_initial 0)
axiom kc_mid_val    : (= kc_mid 1)
axiom kc_end_val    : (= kc_end 0)
axiom kc_lb         : (>= kc_current kc_initial)
axiom kc_ub         : (<= kc_current kc_mid)

; --- Non-negativity constraints ---
axiom nn_sm_1       : (>= (soil_moisture 1) 0)
axiom nn_sm_2       : (>= (soil_moisture 2) 0)
axiom nn_sm_3       : (>= (soil_moisture 3) 0)
axiom nn_et         : (>= et_reference 0)
axiom nn_etc        : (>= et_crop 0)
axiom nn_deficit    : (>= irrigation_deficit -10)
axiom nn_rain       : (>= effective_rainfall 0)

; --- Soil moisture upper bounds (cannot exceed field capacity) ---
axiom sm_upper_1    : (<= (soil_moisture 1) (field_capacity 1))
axiom sm_upper_2    : (<= (soil_moisture 2) (field_capacity 2))
axiom sm_upper_3    : (<= (soil_moisture 3) (field_capacity 3))

; --- FAO-56 Eq.1 linearised: ETc = ETo (at Kc = kc_mid = 1, mid-season) ---
; Non-linear form et_crop = et_reference * kc_current replaced by QF_LRA equivalent
axiom etc_def       : (= et_crop et_reference)

; --- FAO-56 Eq.65 linearised: D_r = ETc - P_eff - sum_d_i ---
axiom deficit_def   : (= irrigation_deficit (- et_crop (+ effective_rainfall irrigation_applied_total)))
axiom appl_total_nn : (>= irrigation_applied_total 0)

; --- ISO 11783-10 Annex B.2 application rate limits ---
axiom max_app_rate  : (= max_application_rate 20)
axiom min_app_zone  : (= min_application_per_zone 5)
