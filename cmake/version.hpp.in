/**
 * @file version.hpp
 * @brief Version and format identifiers of every artefact producer (generated by CMake).
 * @ingroup core
 *
 * These strings are written into IR documents, package manifests, ledger
 * records and API responses so that every artefact states exactly which tool
 * produced it. Do not edit the generated file; edit cmake/version.hpp.in and
 * the TWIN_* variables in the top-level CMakeLists.txt.
 */
#pragma once

#include <string_view>

namespace twin::version {

/// Project version (semantic versioning).
inline constexpr std::string_view kProject = "@PROJECT_VERSION@";
/// Version of the V_D -> IR compiler.
inline constexpr std::string_view kCompiler = "@TWIN_COMPILER_VERSION@";
/// Version of the semantic kernel implementation.
inline constexpr std::string_view kKernel = "@TWIN_KERNEL_VERSION@";
/// Kernel compatibility identifier; packages declare the one they require.
inline constexpr std::string_view kKernelCompat = "@TWIN_KERNEL_COMPAT@";
/// Twin IR document format identifier.
inline constexpr std::string_view kIrFormat = "@TWIN_IR_FORMAT@";
/// Verified Twin Package format identifier.
inline constexpr std::string_view kPackageFormat = "@TWIN_PACKAGE_FORMAT@";
/// Execution ledger record schema identifier.
inline constexpr std::string_view kLedgerSchema = "@TWIN_LEDGER_SCHEMA@";

}  // namespace twin::version
