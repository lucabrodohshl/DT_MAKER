/**
 * @file aligner_identity.hpp
 * @brief Identity of the semantic aligner sources compiled into this build (generated by CMake).
 * @ingroup alignment
 *
 * kAlignerSourceDigest is SHA-256 over the sorted list of "<relative path> <sha256>"
 * lines of every source and header file of SemPTDTAlignmentICSE that is compiled
 * into aligner::dtpta / aligner::semalign. Alignment evidence records it, so a
 * verdict can always be traced to the exact aligner implementation that produced it.
 */
#pragma once

#include <string_view>

namespace twin::alignment {

/// @brief Human-readable aligner name.
inline constexpr std::string_view kAlignerName = "SemPTDTAlignmentICSE";
/// @brief Digest of the aligner sources compiled into this build.
inline constexpr std::string_view kAlignerSourceDigest = "@TWIN_ALIGNER_DIGEST@";
/// @brief Number of aligner files covered by the digest.
inline constexpr int kAlignerSourceFiles = @TWIN_ALIGNER_FILE_COUNT@;

}  // namespace twin::alignment
