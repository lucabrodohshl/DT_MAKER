    "on": "violated",
    "severity": "critical",
    "message": "Controller events deviate from the verified chamber model"
   },
   {
    "id": "AL-2",
    "monitor": "never-overheated",
    "on": "violated",
    "severity": "critical",
    "message": "Chamber overheated"
   },
   {
    "id": "AL-3",
    "monitor": "temperature-fresh",
    "on": "finding",
    "severity": "warning",
    "message": "Temperature is stale"
   }
  ]
 },
