 "assurance": {
  "format": "twin-monitors/1",
  "requirements": [
   {
    "id": "REQ-S1",
    "title": "Chamber never overheats",
    "category": "safety",
    "severity": "critical",
    "description": "The air temperature never exceeds the 80 degC limit.",
    "monitors": [
     "never-overheated"
    ],
    "formal": "A[] !OVERHEATED"
   },
   {
    "id": "REQ-T1",
    "title": "Cool down at least 30 s",
    "category": "timing",
    "severity": "warning",
    "description": "The over-temperature latch is reset no earlier than 30 s after it was set.",
    "monitors": []
   },
   {
    "id": "REQ-C1",
    "title": "Controller events conform",
    "category": "operational",
    "severity": "critical",
    "description": "Every controller event is admitted by the verified twin.",
    "monitors": [
     "conformance"
    ]
   },
   {
    "id": "REQ-O1",
    "title": "Fresh temperature",
    "category": "operational",
    "severity": "warning",
    "description": "Air temperature telemetry is never older than 30 s.",
    "monitors": [
     "temperature-fresh"
    ]
   }
  ],
  "monitors": [
   {
    "id": "conformance",
    "kind": "conformance",
    "name": "Behavioural conformance",
    "severity": "critical",
    "events": "all",
    "unmatchedEvents": "record",
    "requirement": "REQ-C1"
   },
   {
    "id": "never-overheated",
    "kind": "property",
    "name": "Overheating monitor",
    "severity": "critical",
    "property": "A[] !OVERHEATED",
    "requirement": "REQ-S1"
   },
   {
    "id": "heating-watchdog",
    "kind": "property",
    "name": "Heating at most 10 min",
    "severity": "warning",
    "property": "A[] (HEATING -> t <= 600)"
   },
   {
    "id": "temperature-fresh",
    "kind": "data_quality",
    "name": "Temperature freshness",
    "severity": "warning",
    "field": "temperature",
    "check": "stale",
    "maxAgeSeconds": 30,
    "requirement": "REQ-O1"
   },
   {
    "id": "temperature-range",
    "kind": "data_quality",
    "name": "Temperature plausible",
    "severity": "warning",
    "field": "temperature",
    "check": "out_of_range",
    "min": -40,
    "max": 200
   }
  ],
  "alerts": [
