 "assurance": {
  "format": "twin-monitors/1",
  "requirements": [
   {
    "id": "REQ-S1",
    "title": "No silent mission failure",
    "category": "safety",
    "severity": "critical",
    "description": "The twin must never reach MISSION_FAILED without an operator alert.",
    "monitors": [
     "never-mission-failed"
    ],
    "formal": "A[] !MISSION_FAILED"
   },
   {
    "id": "REQ-T1",
    "title": "Replan within 5 s",
    "category": "timing",
    "severity": "warning",
    "description": "A replacement route is selected within 5 s of a route invalidation.",
    "monitors": [
     "replanning-deadline"
    ],
    "formal": "A[] (REPLANNING -> t_mode <= 5)"
   },
   {
    "id": "REQ-C1",
    "title": "Behaviour conforms to the verified model",
    "category": "operational",
    "severity": "critical",
    "description": "Every flight-controller event is admitted by the verified mission model.",
    "monitors": [
     "conformance"
    ]
   },
   {
    "id": "REQ-O1",
    "title": "Fresh battery telemetry",
    "category": "operational",
    "severity": "warning",
    "description": "Battery telemetry is never older than 5 s while live.",
    "monitors": [
     "battery-fresh",
     "battery-range"
    ]
   }
  ],
  "monitors": [
   {
    "id": "conformance",
    "kind": "conformance",
    "name": "Behavioural conformance",
    "severity": "critical",
    "events": "all",
    "unmatchedEvents": "record",
    "requirement": "REQ-C1"
   },
   {
    "id": "never-mission-failed",
    "kind": "property",
    "name": "Mission never fails",
    "severity": "critical",
    "property": "A[] !MISSION_FAILED",
    "requirement": "REQ-S1"
   },
   {
    "id": "replanning-deadline",
    "kind": "property",
    "name": "Replanning within its deadline",
    "severity": "warning",
    "property": "A[] (REPLANNING -> t_mode <= 5)",
    "requirement": "REQ-T1"
   },
   {
    "id": "battery-fresh",
    "kind": "data_quality",
    "name": "Battery telemetry freshness",
    "severity": "warning",
    "field": "battery_level",
    "check": "stale",
    "maxAgeSeconds": 5,
    "requirement": "REQ-O1"
   },
   {
    "id": "battery-range",
    "kind": "data_quality",
    "name": "Battery telemetry range",
    "severity": "warning",
    "field": "battery_level",
    "check": "out_of_range",
    "min": 0,
    "max": 100,
    "requirement": "REQ-O1"
   }
  ],
  "alerts": [
   {
    "id": "AL-1",
    "monitor": "conformance",
    "on": "violated",
    "severity": "critical",
    "message": "Behaviour deviates from the verified mission model"
   },
   {
    "id": "AL-2",
    "monitor": "never-mission-failed",
    "on": "violated",
    "severity": "critical",
    "message": "Mission failed: no admissible plan within the replanning deadline"
   },
   {
    "id": "AL-3",
    "monitor": "battery-fresh",
    "on": "finding",
    "severity": "warning",
    "message": "Battery telemetry is stale"
   }
  ]
 },
 "simulation": {
  "$file": "simulation.json"
 },
 "scenarios": [
  {
   "id": "blocked-east-corridor",
   "name": "Blocked East Corridor",
   "description": "The ground truth contains an obstacle in the east corridor that the twin does not know. When it becomes sensor-visible the route is invalidated, the twin replans and resumes navigation within the 5 s deadline.",
   "start": {
    "kind": "initial"
   },
   "steps": [
    {
     "id": "s1",
     "kind": "world",
     "at": "0",
     "change": {
      "action": "add_object",
      "object": {
       "id": "east-corridor-obstacle",
       "layer": "as-built",
       "kind": "rect",
       "semanticType": "obstacle",
       "name": "Pallet in east corridor",
       "geometry": {
        "x": 22000,
        "y": 6500,
        "w": 1000,
        "h": 1500
       },
       "properties": {},
       "tags": [
        "scenario"
       ]
      }
     }
    },
    {
     "id": "s2",
     "kind": "event",
     "label": "mission_loaded!",
     "at": "0.5"
    },
    {
     "id": "s3",
     "kind": "event",
     "label": "start_mission!",
     "at": "1"
    },
    {
     "id": "s4",
     "kind": "event",
     "label": "takeoff_complete!",
     "at": "4"
    },
    {
     "id": "s5",
     "kind": "expect",
