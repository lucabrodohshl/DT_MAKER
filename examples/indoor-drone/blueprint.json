 "presentation": {
  "displayName": "Indoor Inspection Drone",
  "icon": "drone",
  "primaryView": "world",
  "plugin": "drone",
  "keyTelemetry": [
   "battery_level",
   "speed",
   "altitude",
   "fc_mode"
  ],
  "importantAssets": [
   "drone",
   "lidar",
   "battery"
  ],
  "importantPropositions": [
   "at_NAVIGATING",
   "at_REPLANNING",
   "at_MISSION_FAILED"
  ],
  "importantMonitors": [
   "conformance",
   "never-mission-failed",
   "battery-fresh"
  ],
  "importantPredictions": [
   "replan_timeout!"
  ],
  "states": {
   "INITIALIZING": {
    "label": "Initializing",
    "tone": "neutral",
    "summary": "Waiting for the mission to be loaded."
   },
   "READY": {
    "label": "Ready",
    "tone": "info",
    "summary": "Mission loaded; pre-flight checks pending."
   },
   "TAKING_OFF": {
    "label": "Taking off",
    "tone": "info",
    "summary": "Motors spinning up; climbing to cruise height."
   },
   "NAVIGATING": {
    "label": "Navigating",
    "tone": "ok",
    "summary": "Following a validated route to the current target."
   },
   "REPLANNING": {
    "label": "Replanning",
    "tone": "warning",
    "summary": "The route was invalidated; a new admissible route is due within 5 s."
   },
   "HOVERING": {
    "label": "Hovering (obstacle)",
    "tone": "warning",
    "summary": "Collision-avoidance brake: holding position in front of an obstacle."
   },
   "INSPECTING": {
    "label": "Inspecting",
    "tone": "info",
    "summary": "360-degree inspection of the target in progress."
   },
   "RETURNING": {
    "label": "Returning",
    "tone": "info",
    "summary": "Flying back to the landing pad."
   },
   "RETURN_REPLANNING": {
    "label": "Replanning (return)",
    "tone": "warning",
    "summary": "The way home was invalidated; replanning."
   },
   "LANDING": {
    "label": "Landing",
    "tone": "info",
    "summary": "Descending onto the landing pad."
   },
   "LANDED": {
    "label": "Landed",
    "tone": "ok",
    "summary": "Mission complete; motors disarmed."
   },
   "MISSION_FAILED": {
    "label": "Mission failed",
    "tone": "critical",
    "summary": "No admissible plan within the replanning deadline."
   }
